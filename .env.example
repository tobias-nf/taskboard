# LLM
ANTHROPIC_API_KEY=sk-ant-...

# Taskboard API admin (required by `taskboard-api/cmd/server`)
TASKBOARD_ADMIN_API_KEY=hive_sk_hive-admin_replace-me

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# For local dev you can leave these empty and use DEV_MODE=true instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Session signing key — use a random string in production
SESSION_SECRET=dev-secret-change-me

# URL the API redirects to after OAuth (must match the Next.js app basePath)
FRONTEND_URL=http://localhost:3000/app

# Only allow sign-ups from this email domain
ALLOWED_EMAIL_DOMAIN=near.foundation

# Enable /auth/dev-login endpoint (skip Google OAuth for local testing)
DEV_MODE=true

# Optional: env-managed agents (upserted by the API at startup)
# Format: api_key|name|type|description[|email]
# TASKBOARD_ENSURE_AGENT_1=hive_sk_agent-id_secret|Agent Name|service|Description
# TASKBOARD_ENSURE_AGENT_2=hive_sk_agent-id_secret|Agent Name|personal|Description|email@example.com

# Taskboard App (Next.js)
NEXT_PUBLIC_TASKBOARD_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_TASKBOARD_AUTH_URL=http://localhost:4000/auth
NEXT_PUBLIC_DEV_MODE=true
